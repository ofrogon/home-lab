# Set in Portainer or Dockhand
TZ=America/Montreal
RESTART_POLICY=unless-stopped
POSTGRES_IMAGE_TAG=13-alpine
POSTGRES_DATA_PATH=/docker/mattermost/postgres
POSTGRES_USER=mmuser
POSTGRES_PASSWORD=
POSTGRES_DB=mattermost
MATTERMOST_CONFIG_PATH=/docker/mattermost/server/config
MATTERMOST_DATA_PATH=/docker/mattermost/server/data
MATTERMOST_LOGS_PATH=/docker/mattermost/server/logs
MATTERMOST_PLUGINS_PATH=/docker/mattermost/server/plugin
MATTERMOST_CLIENT_PLUGINS_PATH=/docker/mattermost/server/client
MATTERMOST_BLEVE_INDEXES_PATH=/docker/mattermost/server/bleve
MM_BLEVESETTINGS_INDEXDIR=/mattermost/bleve-indexes
MATTERMOST_IMAGE=mattermost-team-edition
MATTERMOST_IMAGE_TAG=latest
MATTERMOST_CONTAINER_READONLY=false
MM_SQLSETTINGS_DRIVERNAME=postgres
MM_SUPPORTSETTINGS_SUPPORTEMAIL=
BASE_URL=
TOP_URL=
